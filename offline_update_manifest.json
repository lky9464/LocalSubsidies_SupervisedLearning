{
  "schema_version": 2,
  "target_version": "0.6.1",
  "from_min": "0.3.0",
  "mode": "full_sync",
  "preserve_always": [
    "configs/local.yaml",
    ".venv",
    "vendor/wheels",
    "vendor/python"
  ],
  "update_types": {
    "full_sync": {
      "label": "Full sync to latest (v0.3.0+)",
      "copy_paths": ["api", "src", "scripts", "tests", "docs", "web/out", "configs"],
      "copy_root_files": [
        "requirements.txt",
        "requirements.lock.txt",
        "RunWebNext.bat",
        "SetupOffline.bat",
        "InitDataRoot.bat",
        "UpdateOffline.bat",
        "CleanupLegacy.bat",
        "README.md",
        "offline_update_manifest.json",
        "TLS4902R_Layout.csv"
      ],
      "skip_relative_files": [
        "configs/local.yaml"
      ],
      "web_out_zip": true,
      "wheels_reinstall": false
    },
    "ui_only": {
      "label": "UI only",
      "copy_paths": [],
      "copy_root_files": [],
      "skip_relative_files": [],
      "web_out_zip": true,
      "wheels_reinstall": false
    },
    "app_code": {
      "label": "API/pipeline/UI",
      "copy_paths": ["api", "src", "scripts"],
      "copy_root_files": [],
      "skip_relative_files": [],
      "web_out_zip": true,
      "wheels_reinstall": false
    }
  },
  "releases": [
    {
      "version": "0.6.1",
      "from_min": "0.3.0",
      "update_type": "full_sync",
      "wheels_reinstall": false,
      "notes": "Full sync. group_random split mode + UI + 04 group audit. No deps change."
    },
    {
      "version": "0.6.0",
      "from_min": "0.3.0",
      "update_type": "full_sync",
      "wheels_reinstall": false,
      "notes": "Full sync. GBM/Stacked/EasyEnsemble v2 tuning + train scripts. No deps change — wheels zip optional if already on v0.5.2+."
    },
    {
      "version": "0.5.2",
      "from_min": "0.3.0",
      "update_type": "full_sync",
      "wheels_reinstall": true,
      "wheels_baseline": true,
      "notes": "Full sync from any v0.3.0+ install. Include wheels-win-amd64-py312.zip next to this zip (one-time baseline). Optional CleanupLegacy.bat keeps raw."
    },
    {
      "version": "0.5.1",
      "from_versions": ["0.5.0"],
      "update_type": "app_code",
      "extra_copy_paths": ["tests", "docs"],
      "extra_root_files": [
        "README.md",
        "offline_update_manifest.json",
        "UpdateOffline.bat",
        "scripts/apply_offline_update.ps1",
        "scripts/build_offline_update_package.ps1"
      ],
      "wheels_reinstall": false,
      "notes": "Legacy hop 0.5.0->0.5.1 (prefer full_sync package for 0.5.2+)."
    }
  ]
}
